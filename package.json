{
  "name": "playdisc",
  "productName": "Playdisc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "test": "node --test 'test/**/*.test.mjs'",
    "backup": "bash scripts/backup.sh",
    "release": "node scripts/release.mjs",
    "postinstall": "node scripts/sign-dev-electron.cjs"
  },
  "dependencies": {
    "buffer": "^5.7.1",
    "idb": "^8.0.0",
    "music-metadata-browser": "^2.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wavesurfer.js": "^7.8.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.playdisc.app",
    "productName": "Playdisc",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}.dmg"
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
